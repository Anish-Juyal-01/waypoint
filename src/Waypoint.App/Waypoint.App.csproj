<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Waypoint</AssemblyName>
    <RootNamespace>Waypoint.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WPF owns DPI awareness via app.manifest; WinForms is only used for the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- Tray app: favour a small footprint over GC throughput. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <UiDir>$(MSBuildThisFileDirectory)..\..\ui\</UiDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon; avoid ambiguous type names with WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <ProjectReference Include="..\Waypoint.Core\Waypoint.Core.csproj" />
    <EmbeddedResource Include="Assets\app.ico" LogicalName="app.ico" />
  </ItemGroup>

  <!--
    The React UI (ui/) is built by Vite into ui/dist and embedded into the executable, so the release
    build is a single self-contained file. The UI is built automatically if ui/dist is missing;
    set SkipUiBuild=true to opt out (e.g. when using the Vite dev server via WAYPOINT_DEV_URL).
  -->
  <Target Name="EmbedUi" BeforeTargets="PrepareForBuild">
    <Exec Command="npm install --no-audit --no-fund" WorkingDirectory="$(UiDir)"
          Condition="!Exists('$(UiDir)node_modules') And '$(SkipUiBuild)' != 'true'" />
    <Exec Command="npm run build" WorkingDirectory="$(UiDir)"
          Condition="!Exists('$(UiDir)dist\index.html') And '$(SkipUiBuild)' != 'true'" />
    <ItemGroup>
      <UiFile Include="$(UiDir)dist\**\*" />
      <EmbeddedResource Include="@(UiFile)" LogicalName="ui/%(UiFile.RecursiveDir)%(UiFile.Filename)%(UiFile.Extension)" />
    </ItemGroup>
  </Target>

</Project>
